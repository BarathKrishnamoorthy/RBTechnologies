# Replace this with your real Google OAuth Client ID
# Get it from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# Backend API URL (Default is local for development; update when deployed to Render/Koyeb)
# Example: VITE_API_BASE_URL=https://rb-carpool-backend.onrender.com/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api
